{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/OBitsPlease/MinerDash-Custom-Miners/main/catalog.schema.json",
  "title": "Miner Dash Community Miner Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "miners"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "miners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/miner"
      }
    }
  },
  "$defs": {
    "miner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "source_url",
        "package_url",
        "executable_name",
        "executable_sha256",
        "default_arguments",
        "recommended_algorithm"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "hardware": {
          "type": "array",
          "items": {
            "enum": ["CPU", "AMD", "NVIDIA", "Intel GPU"]
          },
          "uniqueItems": true
        },
        "license": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "package_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "executable_name": {
          "type": "string",
          "pattern": "^[^/\\\\]+$"
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "default_arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommended_algorithm": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
